<header class="topbar ph3">
	<div class="topbar-inner mw8 center flex flex-column flex-row-ns items-center justify-center justify-between-ns gap3 pv3">
		<a class="wordmark f5 tc tl-ns no-underline" href="{{ home_url | e('html_attr') }}">{{ theme.title | default(settings.title) | e }}</a>

		<div class="topbar-actions flex flex-wrap items-center justify-center justify-end-ns gap2">
			{% if theme.darkmodebutton %}
				<button class="icon-btn flex items-center gap2 pa2 f6 pointer" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode" aria-pressed="false">
					<span class="theme-icon theme-icon-light" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
					</span>
					<span class="theme-icon theme-icon-dark" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
					</span>
				</button>
			{% endif %}
			<button class="icon-btn flex items-center gap2 pa2 f6 pointer" id="toc-toggle" aria-expanded="false" aria-controls="toc-panel">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="14" y2="17"/></svg>
				<span>{{ theme.contents | default('Contents') | e }}</span>
			</button>

            {% if widgets %}
                {% for index,widget in widgets %}
                    <div id="{{ index | e('html_attr') }}" class="toolbar-icon f4 mr3 mv2">
                        {{ widget | raw }}
                    </div>
                {% endfor %}
            {% endif %}

            {% if theme.headerbutton %}
				<a class="btn btn-order ml2 ph3 pv2 ink-bg paper-bg br1 f6 fw5 no-underline" href="{{ theme.headerbuttonLink|default(home_url ~ '#order') | e('html_attr') }}">{{ theme.headerbuttonLabel|default('Order') | e }}</a>
			{% endif %}
		</div>
	</div>
</header>
